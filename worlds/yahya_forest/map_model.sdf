<sdf version="1.9">
  <model name="my_map">
    <static>true</static>
    <link name="map_link">
      <visual name="map_visual">
        <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
          <label>0</label>
        </plugin>
        <geometry>
          <mesh>
            <uri>meshes/Terrain_fixed.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="map_collision">
        <geometry>
          <mesh>
            <uri>meshes/Terrain_fixed.dae</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
    <pose>0 0 0 0 0 0</pose>
  </model>
</sdf>
