      </visual>
      <collision name="rocks_collision">
        <geometry>
          <mesh>
            <uri>meshes/rocks/model.dae</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
    <pose>0 0 0 0 0 0</pose>
  </model>
</sdf>
